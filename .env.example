# Renombra este archivo a .env y ajusta los valores

# Local con XAMPP (usuario root sin contraseña, puerto 3306)
DATABASE_URL=mysql+pymysql://root:@localhost:3306/reservas_turisticas

# Local con MySQL Community Server (con contraseña)
# DATABASE_URL=mysql+pymysql://root:tu_password@localhost:3306/reservas_turisticas

# Producción (Aiven / Railway)
# DATABASE_URL=mysql+pymysql://usuario:password@host:puerto/dbname?ssl_disabled=false

API_URL=http://localhost:8000

# Clave secreta para hashear las contraseñas (cambia en producción)
SECRET_KEY=cambia-esta-clave-en-produccion-12345
