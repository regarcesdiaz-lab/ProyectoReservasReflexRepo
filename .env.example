# Renombra este archivo a .env y completa con TUS datos reales de Aiven

# ==========================================
# Base de datos MySQL en Aiven (la nube)
# ==========================================
# 1. Crea cuenta en https://aiven.io
# 2. Crea un servicio MySQL gratis
# 3. Descarga el archivo ca.pem y ponlo en esta misma carpeta
# 4. Reemplaza TU_PASSWORD, TU_HOST y TU_PUERTO con los datos reales

DATABASE_URL=mysql+pymysql://avnadmin:TU_PASSWORD@TU_HOST.aivencloud.com:TU_PUERTO/defaultdb?ssl_ca=ca.pem

# ==========================================
# Alternativa: MySQL local (XAMPP)
# ==========================================
# DATABASE_URL=mysql+pymysql://root:@localhost:3306/reservas_turisticas

# ==========================================
# Configuración de la app
# ==========================================
API_URL=http://localhost:8000

# Clave secreta para hashear contraseñas (cámbiala en producción)
SECRET_KEY=cambia-esta-clave-en-produccion-12345
